{
  "name": "okena-mobile-rn",
  "version": "0.1.0",
  "private": true,
  "description": "Okena mobile terminal client — React Native over the shared Rust core.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contember/okena.git",
    "directory": "mobile/rn"
  },
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "ubrn:android": "cd modules/okena-mobile-ffi && ubrn build android --config ../../ubrn.config.yaml --and-generate --release && node ../../scripts/fix-android-bindings.cjs",
    "ubrn:ios": "cd modules/okena-mobile-ffi && ubrn build ios --config ../../ubrn.config.yaml --and-generate --release"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@shopify/react-native-skia": "2.14.0",
    "okena-mobile-ffi": "file:./modules/okena-mobile-ffi",
    "okena-terminal-view": "file:./modules/okena-terminal-view",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "zustand": "^4.5.5",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3",
    "uniffi-bindgen-react-native": "0.31.0-3",
    "@react-native/jest-preset": "0.86.3"
  },
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  }
}
